{
  "name": "hermes-digital-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HERMES DIGITAL WORLD (working name): a home-Mac control plane and mobile observer for a Hermes Agent administrator.",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "npm run build:client && npm run start -w @hdw/control-plane",
    "build:client": "npm run build -w @hdw/mobile-client",
    "pair": "npm run pair -w @hdw/control-plane",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:mock": "vitest run apps/control-plane/test/e2e-mock.test.ts",
    "smoke:live": "node --import tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@react-three/fiber": "^9.8.1",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "4.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
