# HERMES DIGITAL WORLD control plane. Copy to .env and edit; never commit .env.
# No credentials are needed for the default demo mode.

# Working name shown in the client (not a final brand).
HDW_WORLD_NAME="HERMES DIGITAL WORLD"

# Bind address. Keep 127.0.0.1 unless you are exposing it on a PRIVATE network such as your
# Tailscale address (see docs/private-access.md). Never forward a router port to it.
HDW_HOST=127.0.0.1
HDW_PORT=8787
# Exact origin your phone uses, e.g. http://my-mac.tailnet-name.ts.net:8787 (https:// turns on Secure cookies).
HDW_PUBLIC_ORIGIN=

# Runtime state: SQLite DB, uploads, workspaces, deliverables. Gitignored.
HDW_DATA_DIR=./data

# mock = deterministic demo adapter (no AI model). hermes-runs = live Hermes Runs API.
HDW_ADAPTER=mock
HDW_MOCK_STEP_MS=700
# pass | revise_once | never_pass | fail | hang
HDW_MOCK_SCENARIO=revise_once

# Live Hermes (only when HDW_ADAPTER=hermes-runs). The key is the API_SERVER_KEY you set in
# ~/.hermes/.env. It stays on the Mac and is never sent to the phone.
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# Optional owner policy override (JSON file; see docs/security-and-autonomy.md).
# HDW_POLICY_FILE=./policy.json

# Keep only the last N world events (0 = keep all). Clients re-snapshot when their cursor is pruned.
HDW_EVENT_RETENTION=0
HDW_LOG_LEVEL=info
